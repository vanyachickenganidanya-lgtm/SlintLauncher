import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Tr } from "../strings.slint";
import { AccountItem } from "../types.slint";
import { Btn, IconBtn, Card, Badge, Avatar } from "../widgets.slint";

component AccountRow inherits Rectangle {
    in property <AccountItem> item;
    callback activate();
    callback remove();

    height: 62px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.item.active ? Theme.ely : Theme.border;
    background: touch.has-hover ? Theme.panel-hover : Theme.panel;
    animate background, border-color { duration: 110ms; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activate(); }
    }

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        Avatar {
            head: root.item.head;
            has-head: root.item.has-head;
            initial: root.item.initial;
            size: 38px;
            y: (parent.height - 38px) / 2;
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 7px;
                alignment: start;

                Text {
                    text: root.item.username;
                    color: Theme.text;
                    font-size: Theme.fs-big;
                    font-weight: 700;
                }

                Badge {
                    text: root.item.kind == "ely" ? "Ely.by" : (Tr.ru ? "оффлайн" : "offline");
                    tint: root.item.kind == "ely" ? Theme.ely : Theme.text-faint;
                    y: 2px;
                }

                if root.item.active: Badge {
                    text: Tr.active;
                    tint: Theme.accent;
                    y: 2px;
                }
            }

            Text {
                text: root.item.uuid;
                color: Theme.text-faint;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 4px;

            if !root.item.active: Btn {
                text: Tr.make-active;
                flat: true;
                clicked => { root.activate(); }
            }

            IconBtn {
                glyph: "🗑";
                fg: Theme.danger;
                clicked => { root.remove(); }
            }
        }
    }
}

export component AccountsPage inherits Rectangle {
    in property <[AccountItem]> accounts;
    callback activate(string);
    callback remove(string);
    callback add-account();
    callback open-url(string);

    background: transparent;

    VerticalLayout {
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: Tr.accounts-title;
                    color: Theme.text;
                    font-size: Theme.fs-title;
                    font-weight: 700;
                }

                Text {
                    text: "authserver.ely.by + authlib-injector";
                    color: Theme.text-faint;
                    font-size: Theme.fs-sm;
                }
            }

            Btn {
                text: "＋ " + Tr.add-account;
                tint: Theme.ely;
                y: (parent.height - self.height) / 2;
                clicked => { root.add-account(); }
            }
        }

        if root.accounts.length == 0: Card {
            height: 150px;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "👤";
                    font-size: 40px;
                    horizontal-alignment: center;
                }

                Text {
                    text: Tr.no-accounts;
                    color: Theme.text-dim;
                    font-size: Theme.fs-big;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    Btn {
                        text: Tr.sign-in;
                        tint: Theme.ely;
                        clicked => { root.add-account(); }
                    }
                }
            }
        }

        if root.accounts.length > 0: ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 8px;
                padding-right: 6px;

                for a in root.accounts: AccountRow {
                    item: a;
                    activate => { root.activate(a.id); }
                    remove => { root.remove(a.id); }
                }
            }
        }

        Card {
            height: 74px;

            HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;

                    Text {
                        text: Tr.ru ? "Нет аккаунта Ely.by?" : "No Ely.by account yet?";
                        color: Theme.text;
                        font-size: Theme.fs;
                        font-weight: 600;
                    }

                    Text {
                        text: Tr.ru
                            ? "Регистрация бесплатна и даёт скины/плащи на любых серверах с authlib-injector."
                            : "Registration is free and gives you skins/capes on any authlib-injector server.";
                        color: Theme.text-faint;
                        font-size: Theme.fs-xs;
                        wrap: word-wrap;
                    }
                }

                Btn {
                    text: Tr.register-ely;
                    flat: true;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.open-url("https://account.ely.by/register"); }
                }
            }
        }
    }
}
