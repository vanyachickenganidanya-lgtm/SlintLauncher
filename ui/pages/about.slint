import { Theme } from "../theme.slint";
import { Tr } from "../strings.slint";
import { Btn, Card, Separator } from "../widgets.slint";

export component AboutPage inherits Rectangle {
    in property <string> version;
    callback open-url(string);

    background: transparent;

    VerticalLayout {
        spacing: 12px;

        Text {
            text: Tr.nav-about;
            color: Theme.text;
            font-size: Theme.fs-title;
            font-weight: 700;
        }

        Card {
            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 14px;

                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: Theme.radius;
                        background: @linear-gradient(135deg, Theme.accent 0%, Theme.ely 100%);

                        Text {
                            text: "SL";
                            color: #ffffff;
                            font-size: 22px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;

                        Text {
                            text: Tr.app-name + " " + root.version;
                            color: Theme.text;
                            font-size: Theme.fs-title;
                            font-weight: 700;
                        }

                        Text {
                            text: Tr.tagline;
                            color: Theme.text-dim;
                            font-size: Theme.fs;
                        }
                    }
                }

                Separator { }

                Text {
                    text: Tr.about-text;
                    color: Theme.text-dim;
                    font-size: Theme.fs;
                    wrap: word-wrap;
                }

                Text {
                    text: "Rust · Slint · authlib-injector · Ely.by";
                    color: Theme.text-faint;
                    font-size: Theme.fs-sm;
                }

                Separator { }

                Text {
                    text: Tr.about-links;
                    color: Theme.text;
                    font-size: Theme.fs;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Btn {
                        text: "Ely.by";
                        flat: true;
                        clicked => { root.open-url("https://ely.by"); }
                    }

                    Btn {
                        text: "Slint";
                        flat: true;
                        clicked => { root.open-url("https://slint.dev"); }
                    }

                    Btn {
                        text: "authlib-injector";
                        flat: true;
                        clicked => { root.open-url("https://github.com/yushijinhun/authlib-injector"); }
                    }

                    Btn {
                        text: "GitHub";
                        flat: true;
                        clicked => { root.open-url("https://github.com/vanyachickenganidanya-lgtm/SlintLauncher"); }
                    }
                }
            }
        }
    }
}
