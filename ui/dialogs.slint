import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tr } from "strings.slint";
import { VersionItem } from "types.slint";
import { Btn, IconBtn, Card, Field, Toggle, Separator, Badge, Progress } from "widgets.slint";

component Modal inherits Rectangle {
    in property <string> title;
    in property <length> panel-width: 420px;
    callback close();

    background: Theme.overlay;

    TouchArea {
        clicked => { root.close(); }
    }

    Card {
        width: root.panel-width;
        height: min(parent.height - 40px, body.preferred-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg-alt;

        // swallow clicks so they don't reach the dimmer
        TouchArea { }

        body := VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.fs-big;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                IconBtn {
                    glyph: "✕";
                    clicked => { root.close(); }
                }
            }

            Separator { }

            @children
        }
    }
}

// ------------------------------------------------------------ Ely.by login

export component LoginDialog inherits Modal {
    in-out property <string> login;
    in-out property <string> password;
    in-out property <string> totp;
    in property <bool> busy;
    in property <bool> needs-totp;
    in property <string> error;
    in-out property <string> offline-name;

    callback submit();
    callback submit-offline();
    callback open-url(string);

    title: Tr.login-title;
    panel-width: 400px;

    Text {
        text: Tr.login-hint;
        color: Theme.text-dim;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }

    Field {
        label: Tr.login-field;
        placeholder: "steve@example.com";
        text <=> root.login;
        enabled: !root.busy;
        accepted => { root.submit(); }
    }

    Field {
        label: Tr.password;
        placeholder: "••••••••";
        password: true;
        text <=> root.password;
        enabled: !root.busy;
        accepted => { root.submit(); }
    }

    if root.needs-totp: Field {
        label: Tr.totp;
        placeholder: "123456";
        text <=> root.totp;
        enabled: !root.busy;
        accepted => { root.submit(); }
    }

    if root.error != "": Rectangle {
        height: msg.preferred-height + 16px;
        border-radius: Theme.radius-sm;
        background: Theme.danger.with-alpha(0.14);
        border-width: 1px;
        border-color: Theme.danger.with-alpha(0.45);

        msg := Text {
            x: 10px;
            width: parent.width - 20px;
            text: root.error;
            color: Theme.danger;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }

    if root.busy: Progress {
        value: 0.4;
    }

    Btn {
        text: root.busy ? Tr.signing-in : Tr.sign-in;
        tint: Theme.ely;
        enabled: !root.busy && root.login != "" && root.password != "";
        clicked => { root.submit(); }
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        Btn {
            text: Tr.register-ely;
            flat: true;
            font-size: Theme.fs-xs;
            clicked => { root.open-url("https://account.ely.by/register"); }
        }

        Btn {
            text: Tr.forgot-ely;
            flat: true;
            font-size: Theme.fs-xs;
            clicked => { root.open-url("https://account.ely.by/forgot-password"); }
        }
    }

    Separator { }

    Text {
        text: Tr.offline-mode;
        color: Theme.text;
        font-size: Theme.fs;
        font-weight: 600;
    }

    Text {
        text: Tr.offline-hint;
        color: Theme.text-faint;
        font-size: Theme.fs-xs;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: 8px;

        Field {
            placeholder: "Steve";
            text <=> root.offline-name;
            horizontal-stretch: 1;
        }

        Btn {
            text: Tr.add;
            flat: true;
            enabled: root.offline-name != "";
            clicked => { root.submit-offline(); }
        }
    }
}

// ------------------------------------------------------------ new instance

export component NewInstanceDialog inherits Modal {
    in property <[VersionItem]> versions;
    in-out property <string> name;
    in-out property <string> selected-version;
    in-out property <bool> show-snapshots;
    in-out property <bool> show-old;
    in property <bool> loading;
    in property <string> error;

    callback create();
    callback filters-changed();

    title: Tr.new-instance-title;
    panel-width: 460px;

    Field {
        label: Tr.instance-name;
        placeholder: Tr.ru ? "Моя сборка" : "My instance";
        text <=> root.name;
    }

    HorizontalLayout {
        spacing: 14px;

        Toggle {
            text: Tr.show-snapshots;
            checked <=> root.show-snapshots;
            toggled => { root.filters-changed(); }
        }

        Toggle {
            text: Tr.show-old;
            checked <=> root.show-old;
            toggled => { root.filters-changed(); }
        }
    }

    Text {
        text: Tr.mc-version;
        color: Theme.text-dim;
        font-size: Theme.fs-xs;
    }

    Rectangle {
        height: 220px;
        background: Theme.bg;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        if root.loading: Text {
            text: Tr.ru ? "Загрузка списка версий..." : "Loading version list...";
            color: Theme.text-dim;
            font-size: Theme.fs-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }

        if !root.loading: ScrollView {
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                for v in root.versions: Rectangle {
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    background: v.id == root.selected-version
                        ? Theme.accent.with-alpha(0.25)
                        : (vt.has-hover ? Theme.panel-hover : transparent);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;

                        Text {
                            text: v.id;
                            color: Theme.text;
                            font-size: Theme.fs-sm;
                            font-weight: v.id == root.selected-version ? 700 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Badge {
                            text: v.kind;
                            tint: v.kind == "release" ? Theme.ok
                                : v.kind == "snapshot" ? Theme.warn : Theme.text-faint;
                            y: 6px;
                        }

                        Text {
                            text: v.released;
                            color: Theme.text-faint;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                        }
                    }

                    vt := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.selected-version = v.id; }
                    }
                }
            }
        }
    }

    if root.error != "": Text {
        text: root.error;
        color: Theme.danger;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;

        Btn {
            text: Tr.cancel;
            flat: true;
            clicked => { root.close(); }
        }

        Btn {
            text: Tr.create;
            enabled: root.name != "" && root.selected-version != "";
            clicked => { root.create(); }
        }
    }
}

// ------------------------------------------------------------ confirmation

export component ConfirmDialog inherits Modal {
    in property <string> message;
    in property <string> ok-text;
    callback confirm();

    title: Tr.ru ? "Подтверждение" : "Confirm";
    panel-width: 380px;

    Text {
        text: root.message;
        color: Theme.text-dim;
        font-size: Theme.fs;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;

        Btn {
            text: Tr.cancel;
            flat: true;
            clicked => { root.close(); }
        }

        Btn {
            text: root.ok-text;
            tint: Theme.danger;
            clicked => { root.confirm(); }
        }
    }
}
